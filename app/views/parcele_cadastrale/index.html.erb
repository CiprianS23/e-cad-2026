<% content_for :title, "Parcele Cadastrale" %>

<div class="page-header">
  <h1>Parcele Cadastrale</h1>
  <%= link_to "Parcelă nouă", new_parcela_cadastrala_path, class: "btn btn-primary" %>
</div>

<%= form_with url: parcele_cadastrale_path, method: :get, class: "filter-form" do |f| %>
  <div class="filter-group">
    <%= f.text_field :q, value: params[:q], placeholder: "Caută număr cadastral…", class: "input" %>
    <%= f.text_field :judet, value: params[:judet], placeholder: "Județ", class: "input" %>
    <%= f.select :categoria_folosinta,
          [["Toate categoriile", ""]] + ParcelaCadastrala::CATEGORII_FOLOSINTA.map { |c| [c.humanize, c] },
          {}, { class: "input" } %>
    <%= f.select :status,
          [["Toate statusurile", ""]] + ParcelaCadastrala::STATUSURI.map { |s| [s.capitalize, s] },
          {}, { class: "input" } %>
    <%= f.submit "Filtrează", class: "btn" %>
    <%= link_to "Reset", parcele_cadastrale_path, class: "btn btn-secondary" %>
  </div>
<% end %>

<% if @parcele.any? %>
  <table class="data-table">
    <thead>
      <tr>
        <th>Nr. Cadastral</th>
        <th>Categorie</th>
        <th>Suprafață (mp)</th>
        <th>Județ</th>
        <th>Localitate</th>
        <th>Proprietar</th>
        <th>Status</th>
        <th>Acțiuni</th>
      </tr>
    </thead>
    <tbody>
      <% @parcele.each do |parcela| %>
        <tr>
          <td><strong><%= parcela.numar_cadastral %></strong></td>
          <td><%= parcela.categoria_folosinta&.humanize %></td>
          <td><%= number_with_precision(parcela.suprafata_mp, precision: 2, delimiter: ".") %></td>
          <td><%= parcela.judet %></td>
          <td><%= parcela.localitate %></td>
          <td><%= parcela.proprietar %></td>
          <td><span class="badge badge-<%= parcela.status %>"><%= parcela.status %></span></td>
          <td class="actions">
            <%= link_to "Vezi", parcela, class: "btn btn-sm" %>
            <%= link_to "Editează", edit_parcela_cadastrala_path(parcela), class: "btn btn-sm btn-secondary" %>
            <%= button_to "Șterge", parcela, method: :delete,
                  class: "btn btn-sm btn-danger",
                  data: { turbo_confirm: "Ești sigur că vrei să ștergi parcela #{parcela.numar_cadastral}?" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <div class="empty-state">
    <p>Nu există parcele cadastrale înregistrate.</p>
    <%= link_to "Adaugă prima parcelă", new_parcela_cadastrala_path, class: "btn btn-primary" %>
  </div>
<% end %>
