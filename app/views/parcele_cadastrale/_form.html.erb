<% content_for :map, true %>

<%= form_with model: parcela, class: "parcela-form" do |f| %>
  <% if parcela.errors.any? %>
    <div class="error-summary">
      <strong><%= parcela.errors.count %> erori au împiedicat salvarea:</strong>
      <ul>
        <% parcela.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <fieldset>
    <legend>Date de identificare</legend>
    <div class="field">
      <%= f.label :numar_cadastral, "Număr cadastral *" %>
      <%= f.text_field :numar_cadastral, class: "input", placeholder: "ex: CF 12345" %>
    </div>
    <div class="field">
      <%= f.label :numar_topografic, "Număr topografic" %>
      <%= f.text_field :numar_topografic, class: "input" %>
    </div>
    <div class="field">
      <%= f.label :categoria_folosinta, "Categorie folosință *" %>
      <%= f.select :categoria_folosinta,
            ParcelaCadastrala::CATEGORII_FOLOSINTA.map { |c| [c.humanize, c] },
            { include_blank: "— Selectați —" }, { class: "input" } %>
    </div>
    <div class="field">
      <%= f.label :suprafata_mp, "Suprafață (mp)" %>
      <%= f.number_field :suprafata_mp, class: "input", step: "0.0001", min: 0 %>
    </div>
    <div class="field">
      <%= f.label :status, "Status *" %>
      <%= f.select :status,
            ParcelaCadastrala::STATUSURI.map { |s| [s.capitalize, s] },
            {}, { class: "input" } %>
    </div>
  </fieldset>

  <fieldset>
    <legend>Localizare</legend>
    <div data-controller="siruta"
         data-siruta-url-value="<%= siruta_autocomplete_path %>">
      <div class="field ac-wrap">
        <%= f.label :judet, "Județ *" %>
        <%= f.text_field :judet, class: "input", autocomplete: "off",
              data: { siruta_target: "judetInput",
                      action: "input->siruta#onJudetInput keydown->siruta#onJudetKeydown" } %>
        <ul class="ac-dropdown" data-siruta-target="judetDropdown" hidden></ul>
      </div>
      <div class="field ac-wrap">
        <%= f.label :localitate, "Localitate *" %>
        <%= f.text_field :localitate, class: "input", autocomplete: "off",
              data: { siruta_target: "localitateInput",
                      action: "input->siruta#onLocalitateInput keydown->siruta#onLocalitateKeydown" } %>
        <ul class="ac-dropdown" data-siruta-target="localitateDropdown" hidden></ul>
      </div>
    </div>
    <div class="field">
      <%= f.label :adresa, "Adresă" %>
      <%= f.text_field :adresa, class: "input" %>
    </div>
  </fieldset>

  <fieldset>
    <legend>Proprietar</legend>
    <div class="field">
      <%= f.label :proprietar, "Proprietar" %>
      <%= f.text_field :proprietar, class: "input" %>
    </div>
    <div class="field">
      <%= f.label :cnp_cui_proprietar, "CNP / CUI" %>
      <%= f.text_field :cnp_cui_proprietar, class: "input" %>
    </div>
  </fieldset>

  <fieldset data-controller="draw-map"
            data-draw-map-existing-wkt-value="<%= parcela.geom_wkt.to_s %>">
    <legend>Geometrie — Stereo 70 (SRID 3844)</legend>
    <p class="hint">
      Desenați parcela direct pe hartă <em>sau</em> introduceți manual WKT-ul în câmpul de mai jos.
      Coordonatele sunt stocate în <strong>Stereo 70 (SRID 3844)</strong>.
    </p>

    <div class="field">
      <button type="button" class="btn btn-secondary"
              data-draw-map-target="toggleBtn"
              data-action="click->draw-map#toggle">
        Deschide harta pentru desen
      </button>
    </div>

    <div data-draw-map-target="mapContainer" hidden class="draw-map-container"></div>

    <div class="field" style="margin-top:12px">
      <%= f.label :geom_wkt, "WKT (Stereo 70)" %>
      <%= f.text_area :geom_wkt,
            class: "input input-mono",
            rows: 5,
            placeholder: "MULTIPOLYGON(((585000 388000, ...)))",
            data: { "draw-map-target": "wktField" } %>
    </div>
  </fieldset>

  <div class="form-actions">
    <%= f.submit parcela.new_record? ? "Creează parcela" : "Salvează modificările", class: "btn btn-primary" %>
    <%= link_to "Anulează", parcela.new_record? ? parcele_cadastrale_path : parcela, class: "btn btn-secondary" %>
  </div>
<% end %>
