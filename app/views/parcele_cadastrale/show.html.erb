<% content_for :title, "Parcela #{@parcela.numar_cadastral}" %>

<% if @parcela.geom %>
  <% content_for :head do %>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <% end %>
<% end %>

<div class="page-header">
  <h1>Parcela <%= @parcela.numar_cadastral %></h1>
  <div class="header-actions">
    <%= link_to "Editează", edit_parcela_cadastrala_path(@parcela), class: "btn btn-secondary" %>
    <%= link_to "✏ Digitizare", harta_path, class: "btn btn-secondary" %>
    <%= button_to "Șterge", @parcela, method: :delete,
          class: "btn btn-danger",
          data: { turbo_confirm: "Ești sigur că vrei să ștergi această parcelă?" } %>
    <%= link_to "← Înapoi", parcele_cadastrale_path, class: "btn btn-link" %>
  </div>
</div>

<div class="show-layout">
  <div class="detail-card">
    <h2>Date generale</h2>
    <dl class="detail-list">
      <dt>Număr cadastral</dt>
      <dd><strong><%= @parcela.numar_cadastral %></strong></dd>

      <dt>Număr topografic</dt>
      <dd><%= @parcela.numar_topografic.presence || "—" %></dd>

      <dt>Categorie folosință</dt>
      <dd><%= @parcela.categoria_folosinta&.humanize %></dd>

      <dt>Suprafață</dt>
      <dd><%= number_with_precision(@parcela.suprafata_mp, precision: 2, delimiter: ".") %> mp</dd>

      <dt>Status</dt>
      <dd><span class="badge badge-<%= @parcela.status %>"><%= @parcela.status %></span></dd>
    </dl>

    <h2>Localizare</h2>
    <dl class="detail-list">
      <dt>Județ</dt>
      <dd><%= @parcela.judet %></dd>

      <dt>Localitate</dt>
      <dd><%= @parcela.localitate %></dd>

      <dt>Adresă</dt>
      <dd><%= @parcela.adresa.presence || "—" %></dd>
    </dl>

    <h2>Proprietar</h2>
    <dl class="detail-list">
      <dt>Proprietar</dt>
      <dd><%= @parcela.proprietar.presence || "—" %></dd>

      <dt>CNP / CUI</dt>
      <dd><%= @parcela.cnp_cui_proprietar.presence || "—" %></dd>
    </dl>

    <h2>Geometrie (Stereo 70 / SRID 3844)</h2>
    <dl class="detail-list">
      <dt>WKT</dt>
      <dd><code class="wkt-preview"><%= @parcela.geom&.as_text&.truncate(200) || "Geometrie nedefinită" %></code></dd>
    </dl>
  </div>

  <% if @parcela.geom %>
    <div class="map-panel">
      <h2>Hartă</h2>
      <div id="map"></div>
      <script>
        const geojson  = <%= raw @parcela.geojson_wgs84 %>;
        <% latlng = @parcela.centroid_latlng %>
        const center   = <%= latlng ? "[#{latlng[0]}, #{latlng[1]}]" : "[45.9, 25.0]" %>;

        const map = L.map("map").setView(center, 15);

        L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
          attribution: "© OpenStreetMap contributors"
        }).addTo(map);

        const layer = L.geoJSON(geojson, {
          style: { color: "#d97706", weight: 2, fillOpacity: 0.25 }
        }).addTo(map);

        map.fitBounds(layer.getBounds(), { padding: [30, 30] });
      </script>
    </div>
  <% end %>
</div>
