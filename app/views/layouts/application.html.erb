<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "e-CAD 2026" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="e-CAD 2026">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>

    <% if content_for?(:map) %>
      <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/ol@10.5.0/ol.css" />
      <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/ol-ext@4.0.31/dist/ol-ext.min.css" />
      <script src="https://cdn.jsdelivr.net/npm/ol@10.5.0/dist/ol.js"></script>
      <script src="https://cdn.jsdelivr.net/npm/ol-ext@4.0.31/dist/ol-ext.min.js"></script>
      <script src="https://cdn.jsdelivr.net/npm/jsts@2.11.3/dist/jsts.min.js"></script>
      <script src="https://cdn.jsdelivr.net/npm/dxf-parser@1.1.2/dist/dxf-parser.min.js"></script>
      <script src="https://unpkg.com/proj4@2.9.0/dist/proj4.js"></script>
    <% end %>

    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav class="topnav">
      <%= link_to "e-CAD 2026", root_path, class: "brand" %>
      <%= link_to "Hartă", harta_path %>
      <%= link_to "Parcele", parcele_cadastrale_path %>
      <%= link_to "Fișiere CGXML", cgxml_files_path %>
      <%= link_to "Import CGXML", new_cgxml_import_path %>
      <%= link_to "Sidekiq", "/sidekiq", target: "_blank" %>
    </nav>

    <% unless content_for?(:fullpage) %>
      <div class="container">
        <% flash.each do |type, message| %>
          <div class="flash <%= type %>"
               data-controller="flash"
               data-flash-sticky="<%= %w[alert error].include?(type.to_s) %>">
            <span class="flash-msg"><%= message %></span>
            <button type="button" class="flash-close" aria-label="Închide"
                    data-action="click->flash#dismiss">✕</button>
          </div>
        <% end %>
        <%= yield %>
      </div>
    <% else %>
      <% flash.each do |type, message| %>
        <div class="flash-overlay <%= type %>"
             data-controller="flash"
             data-flash-sticky="<%= %w[alert error].include?(type.to_s) %>">
          <span class="flash-msg"><%= message %></span>
          <button type="button" class="flash-close" aria-label="Închide"
                  data-action="click->flash#dismiss">✕</button>
        </div>
      <% end %>
      <%= yield %>
    <% end %>
  </body>
</html>
