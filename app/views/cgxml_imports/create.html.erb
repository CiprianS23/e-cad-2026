<% content_for :title, "Rezultat import — #{@filename}" %>

<div class="page-header">
  <h1>Rezultat import: <span class="filename-badge"><%= @filename %></span></h1>
  <div class="header-actions">
    <%= link_to "Import nou", new_cgxml_import_path, class: "btn btn-primary" %>
  </div>
</div>

<% if @result.import_errors.any? && @result.total_saved == 0 %>
  <div class="flash alert" style="margin-bottom:20px">
    <strong>Import eșuat.</strong> Fișierul conține erori care au împiedicat importul.
    <ul style="margin-top:8px;padding-left:18px">
      <% @result.import_errors.each do |err| %>
        <li><strong><%= err[:entity] %>:</strong> <%= err[:message] %></li>
      <% end %>
    </ul>
  </div>
<% elsif @result.partial? %>
  <div class="flash alert" style="margin-bottom:20px">
    <strong>Import parțial</strong> — <%= @result.import_errors.size %> înregistrare(i) respinse.
    Restul datelor (<%= @result.total_saved %> înregistrări) au fost salvate.
    Validarea CGXML v3 a fost programată și rulează în fundal.
  </div>
<% else %>
  <div class="flash notice" style="margin-bottom:20px">
    <strong>Import reușit!</strong>
    Fișierul <strong><%= @filename %></strong> a fost importat (<%= @result.total_saved %> înregistrări).
    Validarea CGXML v3 rulează în fundal.
  </div>
<% end %>

<div class="show-layout" style="grid-template-columns: 1fr 1fr; gap: 20px;">
  <div class="detail-card">
    <h2>Entități importate</h2>
    <table class="data-table" style="margin-top:12px">
      <thead>
        <tr>
          <th>Entitate</th>
          <th style="text-align:right">Salvate</th>
        </tr>
      </thead>
      <tbody>
        <%
          labels = {
            file_descriptions:       "FileDescription (Fișiere)",
            addresses:               "Address (Adrese)",
            deeds:                   "Deed (Acte)",
            lands:                   "Land (Terenuri)",
            buildings:               "Building (Construcții)",
            building_common_parts:   "BuildingCommonPart (Părți comune)",
            individual_units:        "IndividualUnit (Unități individuale)",
            parcels:                 "Parcel (Parcele)",
            registrations:           "Registration (Înscrieri)",
            registration_x_entities: "RegistrationXEntity (Linkuri înscrieri)",
            points:                  "Points (Puncte topografice)",
            persons:                 "Person (Persoane)",
            contesteds:              "Contested (Contestații)",
            contested_x_entities:    "ContestedXEntity (Linkuri contestații)"
          }
        %>
        <% labels.each do |key, label| %>
          <% count = @result.counts[key] %>
          <% next if count.zero? %>
          <tr>
            <td><%= label %></td>
            <td style="text-align:right;font-weight:600;color:#065f46"><%= count %></td>
          </tr>
        <% end %>
        <tr style="border-top:2px solid #e5e7eb;font-weight:700">
          <td>Total</td>
          <td style="text-align:right"><%= @result.total_saved %></td>
        </tr>
      </tbody>
    </table>

    <% if @result.import_errors.any? %>
      <h3 style="margin-top:20px;color:#991b1b">Înregistrări respinse (<%= @result.import_errors.size %>)</h3>
      <div class="error-list-simple" style="margin-top:8px">
        <% @result.import_errors.each do |err| %>
          <div class="simple-error">
            <span class="badge badge-error"><%= err[:entity] %></span>
            <%= err[:message] %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if @result.file_description %>
    <% fd = @result.file_description %>
    <div class="detail-card">
      <h2>Detalii fișier</h2>
      <dl class="detail-list" style="margin-top:12px">
        <dt>Fișier</dt>
        <dd><%= fd.filename %></dd>
        <% if fd.exportdate %>
          <dt>Dată export</dt>
          <dd><%= fd.exportdate.strftime("%d.%m.%Y %H:%M") %></dd>
        <% end %>
        <% if fd.operationtype.present? %>
          <dt>Tip operațiune</dt>
          <dd><%= fd.operationtype %></dd>
        <% end %>
        <% if fd.licensedname.present? %>
          <dt>Persoană autorizată</dt>
          <dd><%= fd.licensedname %></dd>
        <% end %>
        <% if fd.licensenumber.present? %>
          <dt>Nr. licență</dt>
          <dd><%= fd.licensenumber %></dd>
        <% end %>
        <% if fd.fileversion.present? %>
          <dt>Versiune</dt>
          <dd><%= fd.fileversion %></dd>
        <% end %>
      </dl>

      <div style="margin-top:20px;display:flex;gap:10px;flex-wrap:wrap">
        <%= link_to "Raport validare →", cgxml_file_path(fd), class: "btn btn-primary" %>
        <%= link_to "Lista fișierelor", cgxml_files_path, class: "btn btn-secondary" %>
      </div>
    </div>
  <% end %>
</div>
