<% content_for :title, "Hartă Cadastrală" %>
<% content_for :map, true %>
<% content_for :fullpage, true %>

<div class="harta-page"
     data-controller="digitizare"
     data-digitizare-harta-map-outlet="#harta-map"
     data-digitizare-calc-url-value="<%= digitizare_calculeaza_path %>"
     data-digitizare-verifica-url-value="<%= digitizare_verifica_topologie_path %>"
     data-digitizare-export-dxf-url-value="<%= digitizare_export_dxf_path %>"
     data-digitizare-locate-uat-url-value="<%= digitizare_locate_uat_path %>"
     data-digitizare-snap-tolerance-value="15"
     data-digitizare-edit-kind-value="<%= params[:edit_kind] %>"
     data-digitizare-edit-id-value="<%= params[:edit_id] %>"
     data-digitizare-save-batch-url-value="<%= digitizare_save_batch_path %>"
     data-digitizare-cleanup-url-value="<%= digitizare_cleanup_topology_path %>"
     data-digitizare-buffer-drum-url-value="<%= digitizare_buffer_drum_path %>"
     data-digitizare-save-drum-url-value="<%= digitizare_save_drum_path %>"
     data-digitizare-snap-linear-url-value="<%= digitizare_snap_to_linear_path %>">
  <!-- ── Sidebar stânga: filtre + layer manager + base layers (colapsibil) ── -->
  <aside class="harta-sidebar" data-controller="sidebar-toggle">

    <div class="harta-sidebar-body">
      <div class="sidebar-header">
        <h2>Parcele Cadastrale</h2>
        <%= link_to "Adaugă parcelă", new_land_path, class: "btn btn-primary btn-sm" %>
        <button type="button" class="btn-divizare-launch divizare-trigger"
                title="Deschide workflow-ul de divizare proiect parcelar"
                onclick="var t=document.querySelector('.divizare-toolbar'); if(t){t.hidden=false;} document.dispatchEvent(new CustomEvent('divizare-proiect:open'));">
          🔪 Divizare proiect
        </button>
      </div>

      <div class="sidebar-filters">
        <%= form_with url: harta_path, method: :get do |f| %>
          <%= f.text_field :q, value: params[:q], placeholder: "Caută număr cadastral…", class: "input input-sm" %>
          <%= f.select :status,
                [["Toate", ""], ["Activ", "activ"], ["Inactiv", "inactiv"], ["Litigiu", "litigiu"]],
                {}, { class: "input input-sm", data: { action: "change->harta-map#reloadParcele" } } %>
          <%= f.submit "Filtrează", class: "btn btn-sm" %>
        <% end %>
      </div>

      <div class="layer-manager"
           data-controller="layer-manager"
           data-layer-manager-harta-map-outlet="#harta-map">
        <!-- Straturi sus (atenția principală) -->
        <div class="lm-section">
          <div class="lm-section-head">
            <h3>Straturi (Layer Manager)</h3>
            <button type="button" class="lm-reset-all"
                    title="Restaurează valorile implicite pentru toate layer-ele"
                    data-action="click->layer-manager#resetAll">↺ Reset</button>
          </div>
          <ol class="lm-list" data-layer-manager-target="list"></ol>
          <p class="lm-hint">Trage rândurile pentru a schimba ordinea. Click pe pătratul de culoare pentru a edita stilul.</p>
          <%= link_to "🗺  Planuri vechi (georeferențiere)", gis_georef_plans_path, class: "lm-georef-link" %>
        </div>

        <!-- Harta de bază mutată jos (acțiune mai rar utilizată) -->
        <details class="lm-section lm-section--collapsible" data-layer-manager-target="baseSection">
          <summary><h3>Hartă de bază</h3></summary>
          <div class="layer-group" data-layer-manager-target="baseLayers">
            <label class="layer-radio">
              <input type="radio" name="base-layer" value="osm" checked
                     data-action="change->layer-manager#selectBase">
              <span>OpenStreetMap</span>
            </label>
            <label class="layer-radio">
              <input type="radio" name="base-layer" value="google_sat"
                     data-action="change->layer-manager#selectBase">
              <span>Google Satellite</span>
            </label>
            <label class="layer-radio">
              <input type="radio" name="base-layer" value="google_hybrid"
                     data-action="change->layer-manager#selectBase">
              <span>Google Hybrid (sat + drumuri)</span>
            </label>
            <label class="layer-radio">
              <input type="radio" name="base-layer" value="esri"
                     data-action="change->layer-manager#selectBase">
              <span>Esri World Imagery</span>
            </label>
            <label class="layer-radio">
              <input type="radio" name="base-layer" value="ortofotoplan"
                     data-action="change->layer-manager#selectBase">
              <span>Ortofotoplan (ANCPI)</span>
            </label>
            <label class="layer-radio">
              <input type="radio" name="base-layer" value="ortofotoplan_sascut"
                     data-action="change->layer-manager#selectBase">
              <span>Ortofotoplan Sascut 2022</span>
            </label>
          </div>
        </details>
      </div>

      <%= link_to "Listă parcele", lands_path, class: "btn btn-secondary btn-sm sidebar-link" %>
      <%= link_to jurnal_modificari_path, class: "btn btn-secondary btn-sm sidebar-link" do %>
        <%= icon "report" %> Jurnal modificări
      <% end %>
    </div>

    <!-- Toggle bar — colapsare/expansiune sidebar -->
    <button type="button" class="harta-sidebar-toggle"
            data-action="click->sidebar-toggle#toggle"
            title="Închide / Deschide panoul Layere">
      <span class="harta-sidebar-toggle-icon">📋</span>
      <span class="harta-sidebar-toggle-label">Layere</span>
    </button>
  </aside>

  <!-- ── Zona hartă (centru): hartă + linia de comandă + status bar ───────── -->
  <div class="harta-center" style="position:relative">
    <!-- Floating toolbar pentru workflow „Divizare proiect" -->
    <div class="divizare-toolbar"
         hidden
         data-controller="divizare-proiect"
         data-divizare-proiect-harta-map-outlet="#harta-map">
      <div class="divizare-header">
        <span class="divizare-title">🔪 Divizare proiect</span>
        <button class="divizare-phase-tab is-active" data-phase="1"
                data-divizare-proiect-target="phaseTab1"
                data-action="click->divizare-proiect#goToPhase">① Contur</button>
        <button class="divizare-phase-tab" data-phase="2" disabled
                data-divizare-proiect-target="phaseTab2"
                data-action="click->divizare-proiect#goToPhase"
                title="Disponibil după Faza 1">② CGXML fit</button>
        <button class="divizare-phase-tab" data-phase="3" disabled
                data-divizare-proiect-target="phaseTab3"
                data-action="click->divizare-proiect#goToPhase"
                title="Disponibil după Faza 2">③ Zone parcelare</button>
        <button class="divizare-phase-tab" data-phase="4" disabled
                data-divizare-proiect-target="phaseTab4"
                data-action="click->divizare-proiect#goToPhase"
                title="Disponibil după Faza 3">④ Best-fit</button>
        <button class="divizare-phase-tab" data-phase="5" disabled
                data-divizare-proiect-target="phaseTab5"
                data-action="click->divizare-proiect#goToPhase"
                title="Disponibil după Faza 4">⑤ Commit</button>
        <button class="divizare-close"
                data-action="click->divizare-proiect#close"
                title="Închide (pierzi conturul curent)">×</button>
      </div>

      <div class="divizare-body">
        <!-- Faza 1: Contur -->
        <div class="divizare-panel is-active" data-divizare-proiect-target="panel1">
          <!-- Contururi salvate -->
          <div class="divizare-panel-row">
            <label style="font-size:12px;color:#6b7280">Contur existent:</label>
            <select class="input input-sm"
                    style="flex:1;min-width:200px"
                    data-divizare-proiect-target="savedList"></select>
            <button class="btn btn-outline btn-sm"
                    data-divizare-proiect-target="btnLoadSelected"
                    data-action="click->divizare-proiect#loadSelected">
              ⏏ Încarcă
            </button>
            <button class="btn btn-danger btn-sm"
                    data-divizare-proiect-target="btnDeleteSelected"
                    data-action="click->divizare-proiect#deleteSelected"
                    title="Șterge conturul selectat">
              <%= icon "trash" %>
            </button>
          </div>

          <!-- Nume + acțiuni desen -->
          <div class="divizare-panel-row" style="margin-top:6px">
            <label style="font-size:12px;color:#6b7280">Nume:</label>
            <input type="text" class="input input-sm"
                   style="flex:1;min-width:160px"
                   placeholder="Ex: Tarlaua 12 — sat X"
                   data-divizare-proiect-target="contourName">
            <button class="btn btn-primary btn-sm"
                    data-divizare-proiect-target="btnDrawContour"
                    data-action="click->divizare-proiect#startDrawContour">
              <%= icon "pencil" %> Desenează
            </button>
            <button class="btn btn-success btn-sm"
                    data-divizare-proiect-target="btnSaveContour"
                    data-action="click->divizare-proiect#saveContour"
                    disabled>
              <%= icon "save" %> Salvează
            </button>
            <button class="btn btn-outline btn-sm"
                    data-divizare-proiect-target="btnResetContour"
                    data-action="click->divizare-proiect#resetContour">
              ↺ Reset
            </button>
            <button class="btn btn-secondary btn-sm"
                    style="margin-left:auto"
                    data-divizare-proiect-target="btnNextFrom1"
                    data-action="click->divizare-proiect#nextFromPhase1"
                    disabled>
              → Faza 2
            </button>
          </div>

          <div class="divizare-stat" style="margin-top:4px">
            Aria: <strong data-divizare-proiect-target="contourArea">—</strong>
          </div>
          <div class="divizare-stat" data-divizare-proiect-target="contourStatus" style="margin-top:4px;font-size:11px">
            Click „Desenează" sau alege un contur salvat.
          </div>
        </div>

        <!-- Faza 2: CGXML fit (alipire + extindere la contur, area-preserving) -->
        <div class="divizare-panel" data-divizare-proiect-target="panel2">
          <div class="divizare-panel-row">
            <button class="btn btn-primary btn-sm"
                    data-divizare-proiect-target="btnDetectCgxml"
                    data-action="click->divizare-proiect#detectCgxml">
              <%= icon "search" %> Detectează imobile CGXML
            </button>
            <button class="btn btn-success btn-sm"
                    data-divizare-proiect-target="btnApplyFit"
                    data-action="click->divizare-proiect#applyFit"
                    disabled>
              ✓ Aplică bifate
            </button>
            <button class="btn btn-secondary btn-sm"
                    style="margin-left:auto"
                    data-divizare-proiect-target="btnNextFrom2"
                    data-action="click->divizare-proiect#nextFromPhase2"
                    disabled>
              → Faza 3
            </button>
          </div>
          <div class="divizare-stat" data-divizare-proiect-target="fitStatus" style="margin-top:4px;font-size:11px">
            Apasă „Detectează" — vor apărea sub-geometriile lipite la contur (verde), cu confirmare individuală per imobil.
          </div>
          <ul data-divizare-proiect-target="fitList"
              style="list-style:none;padding:0;margin:8px 0 0;max-height:180px;overflow:auto;border-top:1px solid #e5e7eb"></ul>
        </div>

        <!-- Faza 3: Pre-parcelare — simulare fit + parcelare (parcelarea în iterația C) -->
        <div class="divizare-panel" data-divizare-proiect-target="panel3">
          <div class="divizare-panel-row">
            <button class="btn btn-primary btn-sm"
                    data-divizare-proiect-target="btnRecomputeZones"
                    data-action="click->divizare-proiect#recomputeZones">
              🔄 Recalculează zone rămase
            </button>
            <button class="btn btn-secondary btn-sm"
                    style="margin-left:auto"
                    data-divizare-proiect-target="btnNextFrom3"
                    data-action="click->divizare-proiect#nextFromPhase3"
                    disabled>
              → Faza 4
            </button>
          </div>
          <div class="divizare-stat" data-divizare-proiect-target="zoneStatus" style="margin-top:4px;font-size:11px">
            Click „Recalculează" sau intră în Faza 3 — zonele neacoperite (contour − imobile) apar albastru pe hartă.
          </div>
          <div class="divizare-stat" data-divizare-proiect-target="zoneInfo" style="margin-top:4px;font-size:11px;font-weight:600;color:#1d4ed8"></div>

          <div class="divizare-section-label" style="margin-top:10px;font-size:11px;color:#6b7280;font-weight:600">
            SIMULARE FIT (pre-parcelare)
          </div>
          <div style="display:flex;gap:8px;align-items:flex-start">
            <textarea rows="4"
                      class="input input-sm"
                      style="flex:1;font-family:monospace;font-size:12px;min-width:0"
                      placeholder="Suprafețe țintă (mp), una per linie:&#10;2450&#10;1870&#10;980&#10;3200"
                      data-divizare-proiect-target="targetsTextarea"
                      data-action="input->divizare-proiect#targetsTextareaChanged"></textarea>
            <button class="btn btn-primary btn-sm"
                    style="align-self:stretch"
                    data-divizare-proiect-target="btnSimulate"
                    data-action="click->divizare-proiect#simulate"
                    disabled>
              ▶<br>Simulează
            </button>
          </div>

          <div data-divizare-proiect-target="simulateResult" hidden></div>
        </div>

        <!-- Faza 4: Best-fit (placeholder) -->
        <div class="divizare-panel" data-divizare-proiect-target="panel4">
          <p style="color:#6b7280;margin:6px 0">
            🚧 <em>Faza 4 — Ajustare „best-fit" pentru ca toate suprafețele să corespundă țintelor. Iterația D.</em>
          </p>
        </div>

        <!-- Faza 5: Commit (placeholder) -->
        <div class="divizare-panel" data-divizare-proiect-target="panel5">
          <p style="color:#6b7280;margin:6px 0">
            🚧 <em>Faza 5 — Creare definitivă parcele_cadastrale + gis_imobil. Iterația E.</em>
          </p>
        </div>
      </div>
    </div>

    <div id="harta-map"
         data-controller="harta-map"
         data-harta-map-geojson-url-value="<%= geojson_lands_path(params.permit(:q, :status, :categoria_folosinta)) %>"
         data-harta-map-cgxml-geojson-url-value="<%= cgxml_geojson_harta_path %>"
         data-harta-map-cladiri-url-value="<%= geojson_buildings_path %>"
         data-harta-map-uat-url-value="<%= uat_boundaries_geojson_path %>"
         data-harta-map-mapproxy-url-value="http://localhost:8080"
         <% if @base_extent %>data-harta-map-base-extent-value="<%= @base_extent.to_json %>"<% end %>>

    <!-- ── Floating toolbar (stil AutoCAD/QGIS) — acțiuni peste viewport ── -->
    <%# Icons: monochrome SVG (Lucide-style), 18×18, stroke-width 1.6, currentColor.
        Atributele comune sunt mutate într-un helper Ruby cu fragment static. %>
    <% svg = ->(content) { %(<svg class="tb-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">#{content}</svg>).html_safe } %>
    <div class="map-toolbar" data-digitizare-target="mapToolbar">
      <div class="map-toolbar-grip"
           data-action="mousedown->digitizare#onToolbarGripDown"
           title="Trage pentru a muta toolbar-ul">⋮⋮</div>
      <!-- Grup 1: Digitizare nouă -->
      <div class="map-toolbar-group" role="group" aria-label="Creație">
        <button type="button" class="map-tb-btn"
                data-digitizare-target="btnStart"
                data-action="click->digitizare#startDrawing"
                title="Digitizare poligon nou (comandă: PAR sau CL)">
          <%= svg.('<path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><path d="M2 2l7.586 7.586"/><circle cx="11" cy="11" r="2"/>') %>
        </button>
        <button type="button" class="map-tb-btn"
                data-digitizare-target="btnClose"
                data-action="click->digitizare#closePolygon"
                disabled
                title="Închide poligonul curent (comandă: I)">
          <%= svg.('<polygon points="12 2 22 8 22 16 12 22 2 16 2 8 12 2"/>') %>
        </button>
        <button type="button" class="map-tb-btn"
                data-digitizare-target="btnUndo"
                data-action="click->digitizare#undoAction"
                disabled
                title="Undo — anulează ultima acțiune (comandă: U)">
          <%= svg.('<path d="M9 14 4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 0 1 5.5 5.5v0a5.5 5.5 0 0 1-5.5 5.5H11"/>') %>
        </button>
        <button type="button" class="map-tb-btn"
                data-digitizare-target="btnRedo"
                data-action="click->digitizare#redoAction"
                disabled
                title="Redo — refă ultima acțiune anulată (comandă: R)">
          <%= svg.('<path d="m15 14 5-5-5-5"/><path d="M20 9H9.5A5.5 5.5 0 0 0 4 14.5v0A5.5 5.5 0 0 0 9.5 20H13"/>') %>
        </button>
        <button type="button" class="map-tb-btn"
                data-digitizare-target="btnLineDigitize"
                data-action="click->digitizare#startLineDigitize"
                title="Detaliu liniar (drum) — desenează axul; parametrii (lățime + prag alipire) apar în popup">
          <%= svg.('<path d="M4 19 L20 5"/><path d="M2 17 L18 3"/><path d="M6 21 L22 7"/><circle cx="4" cy="19" r="1.5" fill="currentColor"/><circle cx="20" cy="5" r="1.5" fill="currentColor"/>') %>
        </button>
        <button type="button" class="map-tb-btn"
                data-digitizare-target="btnCancelAll"
                data-action="click->digitizare#cancelOperation"
                title="Anulează operațiunea curentă (digitizare sau selecție multiplă)">
          <%= svg.('<circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/>') %>
          <span class="map-tb-badge" data-digitizare-target="multiCountBadge" hidden>0</span>
        </button>
      </div>
      <span class="map-toolbar-sep"></span>
      <!-- Grup 2: Editare poligon selectat -->
      <div class="map-toolbar-group" role="group" aria-label="Editare selecție">
        <button type="button" class="map-tb-btn"
                data-digitizare-target="btnEdit"
                data-action="click->digitizare#editSelected"
                disabled
                title="Modifică vertecșii poligonului selectat (comandă: M)">
          <%= svg.('<path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4Z"/>') %>
        </button>
        <button type="button" class="map-tb-btn"
                data-digitizare-target="btnMove"
                data-action="click->digitizare#moveSelected"
                disabled
                title="Mută poligonul selectat (comandă: MUT)">
          <%= svg.('<path d="M5 9 2 12l3 3"/><path d="m9 5 3-3 3 3"/><path d="m15 19-3 3-3-3"/><path d="m19 9 3 3-3 3"/><path d="M2 12h20"/><path d="M12 2v20"/>') %>
        </button>
        <button type="button" class="map-tb-btn"
                data-digitizare-target="btnRotate"
                data-action="click->digitizare#rotateSelected"
                disabled
                title="Rotește poligonul selectat — click pe un vertex pivot, apoi mișcă cursor-ul (comandă: ROT)">
          <%= svg.('<path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/>') %>
        </button>
        <button type="button" class="map-tb-btn"
                data-digitizare-target="btnDelete"
                data-action="click->digitizare#deleteSelected"
                disabled
                title="Șterge poligonul selectat (comandă: S)">
          <%= svg.('<path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" x2="10" y1="11" y2="17"/><line x1="14" x2="14" y1="11" y2="17"/>') %>
        </button>
      </div>
      <span class="map-toolbar-sep"></span>
      <!-- Grup 3: Selecție multiplă -->
      <div class="map-toolbar-group" role="group" aria-label="Selecție multiplă">
        <button type="button" class="map-tb-btn"
                data-digitizare-target="btnMultiSelect"
                data-action="click->digitizare#toggleMultiSelect"
                aria-pressed="false"
                title="Selecție multiplă: click toggle pe poligoane sau Shift+drag pentru zonă dreptunghiulară">
          <%= svg.('<path d="M3 5a2 2 0 0 1 2-2"/><path d="M19 3a2 2 0 0 1 2 2"/><path d="M21 19a2 2 0 0 1-2 2"/><path d="M5 21a2 2 0 0 1-2-2"/><path d="M9 3h1"/><path d="M9 21h1"/><path d="M14 3h1"/><path d="M14 21h1"/><path d="M3 9v1"/><path d="M21 9v1"/><path d="M3 14v1"/><path d="M21 14v1"/>') %>
          <span class="map-tb-badge" data-digitizare-target="multiSelectBadge" hidden>0</span>
        </button>
        <button type="button" class="map-tb-btn"
                data-digitizare-target="btnPolygonSelect"
                data-action="click->digitizare#startPolygonSelect"
                aria-pressed="false"
                title="Lasso poligon: desenează poligon neregulat (intersecția selectează inclusiv drumuri lungi)">
          <%= svg.('<path d="M7 22a5 5 0 0 1-2-4"/><path d="M3.3 14A6.8 6.8 0 0 1 2 10c0-4.4 4.5-8 10-8s10 3.6 10 8-4.5 8-10 8a12 12 0 0 1-5-1"/><path d="M10.4 19.9c-.7.7-1.7 1.1-2.8 1.1-2.2 0-4-1.8-4-4 0-1.1.4-2.1 1.1-2.8"/>') %>
        </button>
      </div>

      <span class="map-toolbar-sep"></span>

      <!-- Grup 4: Măsurare (distanță / arie) -->
      <div class="map-toolbar-group" role="group" aria-label="Măsurare"
           data-controller="measure"
           data-measure-harta-map-outlet="#harta-map">
        <button type="button" class="map-tb-btn"
                data-measure-target="btnDistance"
                data-action="click->measure#startDistance"
                aria-pressed="false"
                title="Măsurare distanță — click vertecși, dublu-click finalizează. Backspace / Ctrl+Z: șterge ultimul vertex. ESC: anulează schița.">
          <%= svg.('<path d="M21.3 8.7L8.7 21.3a1 1 0 0 1-1.4 0L2.7 16.7a1 1 0 0 1 0-1.4L15.3 2.7a1 1 0 0 1 1.4 0l4.6 4.6a1 1 0 0 1 0 1.4z"/><path d="M7.5 12.5l2 2"/><path d="M10.5 9.5l2 2"/><path d="M13.5 6.5l2 2"/>') %>
        </button>
        <button type="button" class="map-tb-btn"
                data-measure-target="btnArea"
                data-action="click->measure#startArea"
                aria-pressed="false"
                title="Măsurare arie — click vertecși, dublu-click închide poligonul. Backspace / Ctrl+Z: șterge ultimul vertex. ESC: anulează schița.">
          <%= svg.('<path d="M3 6l9-4 9 4v12l-9 4-9-4V6z"/><path d="M3 6l9 4 9-4"/><path d="M12 10v12"/>') %>
        </button>
        <button type="button" class="map-tb-btn"
                data-measure-target="btnClear"
                data-action="click->measure#clearAll"
                title="Șterge toate măsurătorile">
          <%= svg.('<path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" x2="10" y1="11" y2="17"/><line x1="14" x2="14" y1="11" y2="17"/>') %>
        </button>
        <span class="measure-result" data-measure-target="result" aria-live="polite"></span>
      </div>
    </div>
    </div><!-- /#harta-map -->

    <!-- Linia de comandă (stil AutoCAD) — input absolut / relativ / polar -->
    <div class="cad-cmdline">
      <span class="cad-cmdline-prompt">&gt;</span>
      <input type="text" class="cad-cmdline-input"
             data-digitizare-target="cmdInput"
             data-action="keydown->digitizare#onCmdKey"
             placeholder="X,Y  │  doar lungime (direcție cursor)  │  @ΔX,ΔY  │  @lungime&lt;unghi  (Enter)">
      <span class="cad-cmdline-hint" data-digitizare-target="cmdHint">Stereo70 (EPSG:3844)</span>
    </div>

    <!-- Status bar (stil AutoCAD) — toate funcțiile snap + coords + scară + suprafață -->
    <div class="cad-statusbar">
      <button type="button" class="cad-status-toggle cad-status-toggle--on"
              data-digitizare-target="snapToggle"
              data-action="click->digitizare#toggleSnap"
              title="SNAP — comutare prin tastatură: F3">SNAP</button>

      <div class="cad-status-snapmodes" data-digitizare-target="snapModes" title="Moduri OSNAP active">
        <label class="cad-status-mode">
          <input type="checkbox" data-snap-mode="endpoint" checked
                 data-action="change->digitizare#onSnapModeChange">
          <span>ENDP</span>
        </label>
        <label class="cad-status-mode">
          <input type="checkbox" data-snap-mode="midpoint" checked
                 data-action="change->digitizare#onSnapModeChange">
          <span>MID</span>
        </label>
        <label class="cad-status-mode">
          <input type="checkbox" data-snap-mode="nearest"
                 data-action="change->digitizare#onSnapModeChange">
          <span>NEAR</span>
        </label>
        <label class="cad-status-mode">
          <input type="checkbox" data-snap-mode="centroid"
                 data-action="change->digitizare#onSnapModeChange">
          <span>CEN</span>
        </label>
      </div>

      <label class="cad-status-tol" title="Toleranță snap (pixeli)">
        Tol
        <input type="range" min="5" max="50" value="15" class="cad-status-slider"
               data-digitizare-target="snapSlider"
               data-action="input->digitizare#toleranceChanged">
        <span data-digitizare-target="snapToleranceVal">15</span>px
      </label>

      <label class="cad-status-mode" title="Snap metric: prinde vertecșii vecinilor din raza dată în metri (override toleranța în pixeli)">
        <input type="checkbox" data-digitizare-target="metricSnapToggle"
               data-action="change->digitizare#onMetricSnapToggle">
        <span>METRIC</span>
      </label>
      <label class="cad-status-tol" title="Raza de snap în metri reali (Stereo70). Activează doar când METRIC e bifat.">
        <input type="range" min="0.1" max="2.0" step="0.1" value="0.5" class="cad-status-slider"
               data-digitizare-target="metricSnapSlider"
               data-action="input->digitizare#onMetricSnapChange"
               disabled>
        <span data-digitizare-target="metricSnapVal">0.5</span>m
      </label>

      <span class="cad-status-divider">│</span>
      <button type="button" class="cad-status-toggle"
              data-digitizare-target="orthoToggle"
              data-action="click->digitizare#toggleOrtho"
              title="ORTHO — comutare prin tastatură: F8">ORTHO</button>

      <span class="cad-status-divider">│</span>
      <span class="cad-status-coord">X: <span data-digitizare-target="statusX">—</span></span>
      <span class="cad-status-coord">Y: <span data-digitizare-target="statusY">—</span></span>
      <span class="cad-status-divider">│</span>
      <span class="cad-status-meta">Stereo70</span>
      <span class="cad-status-meta">Scară 1:<span data-digitizare-target="statusScale">—</span></span>
      <span class="cad-status-divider">│</span>
      <span class="cad-status-meta">Suprafață: <span data-digitizare-target="statusArea">—</span></span>
    </div>
  </div>

  <!-- ── Panou Digitizare (dreapta, pliabil) ─────────────────────────────── -->
  <aside class="digi-panel digi-panel--collapsed"
         data-digitizare-target="panel">

    <!-- Toggle bar (vizibil mereu) -->
    <button type="button" class="digi-panel-toggle"
            data-action="click->digitizare#togglePanel"
            title="Deschide / Închide Digitizare">
      <span class="digi-panel-toggle-icon">✏</span>
      <span class="digi-panel-toggle-label">Digitizare</span>
    </button>

    <!-- Conținutul (vizibil când e deschis) -->
    <div class="digi-panel-body" data-digitizare-target="panelBody">

      <div class="digi-sidebar-header">
        <span class="digi-title">Digitizare Cadastrală</span>
        <span class="badge badge-info" style="font-size:10px">Stereo 70</span>
      </div>

      <!-- (Coordonate cursor + OSnap + Toleranță au fost mutate în status bar-ul de jos) -->

      <!-- 1. Topologie -->
      <section class="digi-section">
        <div class="digi-section-label">Topologie</div>
        <!-- Mesaje LIVE — apare în timpul digitizare/edit; arată ✓ OK sau erori -->
        <div class="digi-topology" data-digitizare-target="topologyMsg"></div>
        <!-- Audit GLOBAL pe toată baza de date -->
        <div class="digi-btn-row" style="margin-top:6px">
          <button type="button" class="btn btn-secondary btn-sm"
                  data-action="click->digitizare#runAuditTopologie"
                  data-digitizare-target="btnAudit"
                  data-digitizare-url-param="<%= digitizare_audit_topologie_path %>">
            <%= icon "search" %> Scanează erori
          </button>
          <button type="button" class="btn btn-outline btn-sm"
                  data-action="click->digitizare#clearAudit">
            <%= icon "eraser" %> Curăță
          </button>
        </div>
        <div class="digi-audit-list" data-digitizare-target="auditList"></div>

        <!-- Curățare topologică — pe selecție multiplă sau pe viewport -->
        <div style="margin-top:10px;padding-top:8px;border-top:1px solid #e5e7eb">
          <div class="digi-section-label" style="margin-bottom:6px">Curățare topologică</div>
          <p class="digi-parcela-hint" style="font-size:11px;line-height:1.5;margin:0 0 6px 0">
            Unifică vertecșii pe laturi comune, elimină goluri/suprapuneri sub prag. Suprafețele se păstrează în ±1&nbsp;mp; ce depășește = sărit.<br>
            <strong>Selecție</strong> = poligoanele din modul „Selecție multiplă" (click toggle sau lasso poligon).<br>
            <strong>Viewport</strong> = toate poligoanele vizibile în vederea curentă.
          </p>
          <label style="display:block;margin-bottom:6px;font-size:12px">
            Prag goluri/suprapuneri (mp):
            <input type="range" min="0.01" max="2.0" step="0.01" value="0.5"
                   data-digitizare-target="cleanupSlider"
                   data-action="input->digitizare#onCleanupThresholdChange"
                   style="width:100%">
            <span data-digitizare-target="cleanupVal">0.50</span> mp
          </label>
          <div class="digi-btn-row" style="gap:4px">
            <button type="button" class="btn btn-primary btn-sm"
                    data-action="click->digitizare#runCleanupTopology"
                    data-digitizare-target="btnCleanup"
                    style="flex:1"
                    title="Operează pe poligoanele din Selecție multiplă (click sau lasso poligon)">
              <%= icon "broom" %> Curăță selecția
            </button>
            <button type="button" class="btn btn-secondary btn-sm"
                    data-action="click->digitizare#runCleanupViewport"
                    data-digitizare-target="btnCleanupViewport"
                    style="flex:1"
                    title="Operează pe toate poligoanele vizibile în viewport-ul curent">
              <%= icon "globe" %> Curăță viewport
            </button>
          </div>
          <div data-digitizare-target="cleanupResult" style="margin-top:6px;font-size:11px"></div>

          <hr style="margin:12px 0;border:none;border-top:1px solid #e2e8f0">
          <p class="digi-parcela-hint" style="font-size:11px;line-height:1.5;margin:0 0 6px 0">
            <strong>Alipire la detalii liniare:</strong> selectează un imobil pe hartă,
            apoi click pentru a alinia automat vertecșii la marginile drumurilor / căilor
            ferate / canalelor / apelor vecine (categ. <strong>DR, CC, CN, A</strong>).
            Aria cadastrală (FLOOR mp) se păstrează.
          </p>
          <label style="display:block;margin-bottom:6px;font-size:12px">
            Prag alipire (m):
            <input type="range" min="0.05" max="5.0" step="0.05" value="0.5"
                   data-digitizare-target="snapLinearSlider"
                   data-action="input->digitizare#onSnapLinearThresholdChange"
                   style="width:100%">
            <span data-digitizare-target="snapLinearVal">0.50</span> m
          </label>
          <button type="button" class="btn btn-primary btn-sm"
                  data-action="click->digitizare#snapSelectedToLinear"
                  data-digitizare-target="btnSnapLinear"
                  style="width:100%" disabled
                  title="Selectează un imobil pe hartă, apoi click pentru alipire automată la detaliile liniare vecine">
            <%= icon "broom" %> Alipește la detalii liniare
          </button>
          <div data-digitizare-target="snapLinearResult" style="margin-top:6px;font-size:11px"></div>
        </div>
      </section>

      <!-- 2. Status — acțiunile sunt acum în floating toolbar peste hartă -->
      <section class="digi-section">
        <div class="digi-section-label">Status</div>
        <div class="digi-status" data-digitizare-target="statusBar">
          Apăsați ✏ (toolbar pe hartă) sau tastați „PAR" pentru a începe.
        </div>
        <div class="digi-multi-info" data-digitizare-target="multiSelectInfo" style="font-size:12px;color:#ea580c;margin-top:4px;"></div>
      </section>

      <!-- 3. Parcelă / Clădire (toggle + atribute + salvare) -->
      <section class="digi-section">
        <div class="digi-section-label">Parcelă / Clădire</div>

        <!-- Toggle entitate -->
        <div class="digi-entity-toggle">
          <button type="button" class="digi-entity-btn digi-entity-btn--active"
                  data-digitizare-target="btnEntityParcela"
                  data-action="click->digitizare#switchToParcel">
            Parcelă
          </button>
          <button type="button" class="digi-entity-btn"
                  data-digitizare-target="btnEntityCladire"
                  data-action="click->digitizare#switchToBuilding">
            Clădire
          </button>
        </div>

        <!-- Formular parcelă -->
        <div data-digitizare-target="formParcela">
          <%= form_with url: lands_path, method: :post, data: { digitizare_target: "saveForm" } do |f| %>
            <%= hidden_field_tag "parcela_cadastrala[geom_wkt]", "", data: { digitizare_target: "wktField" } %>
            <div class="digi-save-grid">
              <%= f.text_field  "parcela_cadastrala[numar_cadastral]", placeholder: "Nr. cadastral *", class: "input input-sm" %>
              <%= f.select      "parcela_cadastrala[categoria_folosinta]",
                                [["— Categorie *", ""], ["Arabil","arabil"], ["Pășune","pasune"],
                                 ["Fânețe","faneata"], ["Vie","vie"], ["Livadă","livada"],
                                 ["Pădure","padure"], ["Curți/construcții","curti_constructii"],
                                 ["Ape","ape"], ["Neproductiv","neproductiv"]],
                                {}, { class: "input input-sm" } %>
            </div>
            <div data-controller="siruta"
                 data-siruta-url-value="<%= siruta_autocomplete_path %>"
                 style="display:contents">
              <div class="digi-save-grid" style="flex-direction:row">
                <div class="ac-wrap">
                  <%= f.text_field "parcela_cadastrala[judet]",
                        placeholder: "Județ *", class: "input input-sm", autocomplete: "off",
                        data: { siruta_target: "judetInput",
                                action: "input->siruta#onJudetInput keydown->siruta#onJudetKeydown" } %>
                  <ul class="ac-dropdown" data-siruta-target="judetDropdown" hidden></ul>
                </div>
                <div class="ac-wrap">
                  <%= f.text_field "parcela_cadastrala[localitate]",
                        placeholder: "Localitate *", class: "input input-sm", autocomplete: "off",
                        data: { siruta_target: "localitateInput",
                                action: "input->siruta#onLocalitateInput keydown->siruta#onLocalitateKeydown" } %>
                  <ul class="ac-dropdown" data-siruta-target="localitateDropdown" hidden></ul>
                </div>
              </div>
            </div>
            <div class="digi-save-grid">
              <%= f.text_field   "parcela_cadastrala[proprietar]",  placeholder: "Proprietar",   class: "input input-sm" %>
            </div>
            <%# Suprafața apare în secțiunea „Suprafață" de mai jos. Păstrăm un
                hidden ca să nu spargem target-ul `saveAreaField` din JS. %>
            <%= f.hidden_field "parcela_cadastrala[suprafata_mp]",
                               data: { digitizare_target: "saveAreaField" } %>
            <button type="button" class="btn btn-primary btn-sm"
                    style="width:100%;margin-top:8px"
                    data-action="click->digitizare#saveParcel">
              <%= icon "save" %> Salvează parcela
            </button>
          <% end %>
        </div>

        <!-- Formular clădire -->
        <div data-digitizare-target="formCladire" style="display:none">
          <%= form_with url: buildings_path, method: :post, data: { digitizare_target: "saveFormCladire" } do |f| %>
            <%= hidden_field_tag "cladire_cadastrala[geom_wkt]", "", data: { digitizare_target: "wktFieldCladire" } %>
            <div class="digi-save-grid">
              <%= f.text_field "cladire_cadastrala[numar_cadastral]", placeholder: "Nr. cadastral *", class: "input input-sm" %>
              <%= f.select     "cladire_cadastrala[destinatie]",
                               [["— Destinație", ""], ["Locuințe","locuinte"], ["Birouri","birouri"],
                                ["Comercial","comercial"], ["Industrial","industrial"],
                                ["Cult","cult"], ["Învățământ","invatamant"],
                                ["Sănătate","sanatate"], ["Cultură","cultura"],
                                ["Sport","sport"], ["Agrement","agrement"],
                                ["Administrativ","administrativ"], ["Tehnico-edilitar","tehnico_edilitar"],
                                ["Gospodărie","gospodarie"], ["Neproductiv","neproductiv"]],
                               {}, { class: "input input-sm" } %>
            </div>
            <div class="digi-save-grid" style="flex-direction:row">
              <%= f.text_field   "cladire_cadastrala[regim_inaltime]",       placeholder: "Regim înălțime (P, P+1...)", class: "input input-sm" %>
              <%= f.number_field "cladire_cadastrala[suprafata_construita_mp]", placeholder: "Suprafață mp",
                                  step: 0.01, class: "input input-sm",
                                  data: { digitizare_target: "saveAreaFieldCladire" } %>
            </div>
            <div data-controller="siruta"
                 data-siruta-url-value="<%= siruta_autocomplete_path %>"
                 style="display:contents">
              <div class="digi-save-grid" style="flex-direction:row">
                <div class="ac-wrap">
                  <%= f.text_field "cladire_cadastrala[judet]",
                        placeholder: "Județ *", class: "input input-sm", autocomplete: "off",
                        data: { siruta_target: "judetInput",
                                action: "input->siruta#onJudetInput keydown->siruta#onJudetKeydown" } %>
                  <ul class="ac-dropdown" data-siruta-target="judetDropdown" hidden></ul>
                </div>
                <div class="ac-wrap">
                  <%= f.text_field "cladire_cadastrala[localitate]",
                        placeholder: "Localitate *", class: "input input-sm", autocomplete: "off",
                        data: { siruta_target: "localitateInput",
                                action: "input->siruta#onLocalitateInput keydown->siruta#onLocalitateKeydown" } %>
                  <ul class="ac-dropdown" data-siruta-target="localitateDropdown" hidden></ul>
                </div>
              </div>
            </div>
            <div class="digi-parcela-ref">
              <p class="digi-parcela-hint">
                Parcela asociată va fi determinată automat prin intersecție spațială la salvare.
              </p>
            </div>

            <div class="digi-save-grid">
              <%= f.text_field "cladire_cadastrala[proprietar]", placeholder: "Proprietar", class: "input input-sm" %>
            </div>
            <button type="button" class="btn btn-primary btn-sm"
                    style="width:100%;margin-top:8px"
                    data-action="click->digitizare#saveBuilding">
              <%= icon "save" %> Salvează clădirea
            </button>
          <% end %>
        </div>

      </section>

      <!-- 4. Suprafață -->
      <section class="digi-section">
        <div class="digi-section-label">Suprafață</div>
        <div class="digi-area-grid">
          <span class="digi-area-label">Calculată (PostGIS)</span>
          <span class="digi-area-val" data-digitizare-target="areaCalc">—</span>

          <span class="digi-area-label">Din act (mp)</span>
          <input type="number" step="0.01" class="input input-sm digi-area-input"
                 placeholder="0.00"
                 data-digitizare-target="areaAct"
                 data-action="input->digitizare#updateDiff">

          <span class="digi-area-label">Diferență</span>
          <span class="digi-area-diff" data-digitizare-target="areaDiff">—</span>
        </div>
      </section>

      <!-- 5. Import (DXF + manual XY + TXT stație totală) -->
      <section class="digi-section">
        <div class="digi-section-label">Import</div>

        <!-- DXF / KML / GPKG -->
        <div class="digi-btn-row">
          <label class="btn btn-secondary btn-sm" style="cursor:pointer;flex:1">
            📥 Import fișier (DXF / KML / GPKG)
            <input type="file" accept=".dxf,.kml,.gpkg" style="display:none"
                   data-action="change->digitizare#onDxfFileSelected"
                   data-digitizare-target="dxfFileInput"
                   data-digitizare-url-param="<%= digitizare_import_dxf_path %>"
                   data-digitizare-parse-url-param="<%= digitizare_parse_geo_file_path %>">
          </label>
        </div>
        <div class="digi-dxf-mapping" data-digitizare-target="dxfMapping" style="display:none"></div>

        <!-- Manual X/Y -->
        <div class="digi-section-label" style="margin-top:8px">Adaugă punct manual</div>
        <div class="digi-manual-row">
          <input type="number" step="0.001" placeholder="X (E)" class="input input-sm digi-coord-input"
                 data-digitizare-target="inputX">
          <input type="number" step="0.001" placeholder="Y (N)" class="input input-sm digi-coord-input"
                 data-digitizare-target="inputY">
          <button class="btn btn-secondary btn-sm"
                  data-action="click->digitizare#addManualPoint">+ Adaugă</button>
        </div>

        <!-- TXT stație totală -->
        <label class="digi-import-label">
          <input type="file" accept=".txt,.csv" class="digi-file-input"
                 data-action="change->digitizare#importTxt">
          📄 Import TXT stație totală
        </label>
      </section>

      <!-- 6. Export -->
      <section class="digi-section">
        <div class="digi-section-label">Export</div>

        <!-- Pas 1: selectează zona pe hartă (dreptunghi sau poligon) -->
        <div class="digi-btn-row">
          <button type="button" class="btn btn-secondary btn-sm"
                  data-action="click->digitizare#startExportZoneSelect"
                  data-digitizare-shape-param="rect"
                  data-digitizare-target="btnExportZone">
            ▭ Dreptunghi
          </button>
          <button type="button" class="btn btn-secondary btn-sm"
                  data-action="click->digitizare#startExportZoneSelect"
                  data-digitizare-shape-param="polygon"
                  data-digitizare-target="btnExportZonePoly">
            <%= icon "pencil" %> Poligon
          </button>
          <button type="button" class="btn btn-outline btn-sm"
                  data-action="click->digitizare#clearExportZone">
            <%= icon "eraser" %> Curăță
          </button>
        </div>
        <div class="digi-export-status" data-digitizare-target="exportStatus"
             style="margin-top:6px;font-size:11px;color:#6b7280">
          Niciuna zonă selectată
        </div>

        <!-- Pas 2: format + layere + buton export -->
        <div class="digi-save-grid" style="margin-top:8px">
          <select class="input input-sm" data-digitizare-target="exportFormat">
            <option value="dxf" selected>DXF (AutoCAD)</option>
            <option value="kml">KML (Google Earth)</option>
            <option value="gpkg">GPKG (GeoPackage)</option>
          </select>
        </div>
        <div class="digi-export-layers" style="display:flex;gap:10px;font-size:11px;margin-top:4px">
          <label><input type="checkbox" data-digitizare-target="exportLayerParcele" checked> Parcele</label>
          <label><input type="checkbox" data-digitizare-target="exportLayerCladiri" checked> Clădiri</label>
        </div>
        <div class="digi-btn-row" style="margin-top:8px">
          <button type="button" class="btn btn-primary btn-sm"
                  data-action="click->digitizare#exportZone"
                  data-digitizare-target="btnExportZoneSubmit"
                  data-digitizare-url-param="<%= digitizare_export_zone_path %>"
                  disabled>
            <%= icon "download" %> Exportă
          </button>
          <button type="button" class="btn btn-outline btn-sm"
                  data-action="click->digitizare#showRaport">
            <%= icon "report" %> Raport poligon
          </button>
        </div>
      </section>

    </div>
  </aside>
</div>
