/* Tema Qt in stil AutoCAD: gri inchis, accente albastre, contrast ridicat.
   Aplicata peste fereastra principala QGIS de catre ui/theme.py. */

QMainWindow,
QDockWidget,
QWidget {
    background-color: #2b2b2b;
    color: #d6d6d6;
    selection-background-color: #264f78;
    selection-color: #ffffff;
}

QToolBar {
    background-color: #333333;
    border: none;
    spacing: 2px;
    padding: 2px;
}

QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    padding: 3px;
    border-radius: 3px;
}

QToolButton:hover {
    background-color: #3d3d3d;
    border: 1px solid #4a90d9;
}

QToolButton:checked {
    background-color: #264f78;
    border: 1px solid #4a90d9;
}

QMenuBar {
    background-color: #333333;
    color: #d6d6d6;
}

QMenuBar::item:selected {
    background-color: #264f78;
}

QMenu {
    background-color: #333333;
    color: #d6d6d6;
    border: 1px solid #555555;
}

QMenu::item:selected {
    background-color: #264f78;
}

/* Linia de comanda tip AutoCAD: monospaced, fundal aproape negru. */
QPlainTextEdit#CadastruCommandHistory,
QLineEdit#CadastruCommandInput {
    background-color: #1e1e1e;
    color: #e0e0e0;
    font-family: "Consolas", "DejaVu Sans Mono", monospace;
    font-size: 12px;
    border: 1px solid #555555;
}

QStatusBar {
    background-color: #007acc;
    color: #ffffff;
}
